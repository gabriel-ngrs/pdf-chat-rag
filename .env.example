# ─── Provedor de IA ───────────────────────────────────────────────────────────
# Chave da API do Google Gemini. Obtenha em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo de embeddings. A dimensão é fixada em 768 via output_dimensionality
# porque o índice HNSW do pgvector não aceita mais de 2000 dimensões, e o
# default deste modelo é 3072.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Modelo de geração. `gemini-2.5-flash` saiu do ar para chaves novas — o
# provedor responde 404 pedindo a geração 3.x —, então o default mudou.
# thinking_budget=0 porque RAG extrativo não se beneficia do modo de
# raciocínio, que só adiciona latência antes do primeiro token; nos modelos
# 3.x esse zero chega ao provedor como nível mínimo de raciocínio, porque
# eles recusam o orçamento zero com 400.
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_THINKING_BUDGET=0

# ─── Ingestão ─────────────────────────────────────────────────────────────────
# MAX_UPLOAD_MB protege upload e memória; os outros dois protegem a quota de
# embeddings (~30.000 tokens/min no free tier). Megabyte é proxy ruim de custo
# de embedding: PDF de imagens pesa muito e custa pouco.
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=20
MAX_EXTRACTED_CHARS=60000

# Chunking por página, sem cruzar fronteira — é o que torna a citação exata.
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Lotes pequenos: 100 chunks passariam do teto de tokens por requisição e
# consumiriam quase todo o TPM de uma vez.
EMBEDDING_BATCH_SIZE=16

# ─── Retrieval e chat ─────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
# Medido com `make eval` sobre o Exemplo-YAITEC.pdf, não estimado: as negativas
# do dataset chegam no máximo a 0,526 e a pior positiva fica em 0,724. 0,625 é o
# meio dessa folga — ~0,10 de margem para cada lado, o ponto que mais erra tarde
# nos dois sentidos. Não é o valor que maximiza recall (esse seria 0, e destrói
# a recusa). Distribuição completa em backend/eval/README.md.
SIMILARITY_THRESHOLD=0.625
HISTORY_WINDOW=6
CHAT_TIMEOUT_SECONDS=60
CONDENSE_TIMEOUT_SECONDS=5

# ─── Banco ────────────────────────────────────────────────────────────────────
# Os defaults abaixo funcionam para rodar localmente via docker compose.
POSTGRES_USER=talkdoc
POSTGRES_PASSWORD=talkdoc
POSTGRES_DB=talkdoc

# Usado pelos testes de integração e pelo `make eval` a partir do host.
# Dentro do compose o backend recebe o valor com host `db`.
DATABASE_URL=postgresql://talkdoc:talkdoc@localhost:5432/talkdoc
